          <inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
    </model>

    <!-- Extra orange/blue (same 4 marker colors only) -->
    <model name="box_orange_3">
      <pose>-12 -7 0.28 0 0 0.2</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.55 0.55 0.55</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.55 0.55 0.55</size></box></geometry>
          <material><ambient>0.95 0.45 0.05 1</ambient><diffuse>1.0 0.5 0.05 1</diffuse></material>
        </visual>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
