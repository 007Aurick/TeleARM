        <visual name="edge_4"><pose>0 0.46 0.46 0 0 0</pose><geometry><box><size>0.9 0.05 0.05</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
        <visual name="edge_5"><pose>-0.46 0 -0.46 0 0 0</pose><geometry><box><size>0.05 0.9 0.05</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
