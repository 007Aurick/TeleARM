    <model name="box_green_3">
      <pose>4 5.5 0.28 0 0 -0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.55 0.55 0.55</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.55 0.55 0.55</size></box></geometry>
          <material><ambient>0.1 0.75 0.2 1</ambient><diffuse>0.15 0.85 0.25 1</diffuse></material>
        </visual>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
    </model>

    <!-- Corner drop pads (visual only — no collision so avoidance won't bounce on them) -->
    <model name="drop_orange">
      <static>true</static>
      <pose>-14 9 0.03 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.5 1.5 0.06</size></box></geometry>
          <material><ambient>0.95 0.45 0.05 1</ambient><diffuse>1.0 0.5 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="drop_blue">
      <static>true</static>
      <pose>14 9 0.03 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.5 1.5 0.06</size></box></geometry>
          <material><ambient>0.05 0.35 0.95 1</ambient><diffuse>0.1 0.4 1.0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="drop_green">
      <static>true</static>
      <pose>-14 -9 0.03 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.5 1.5 0.06</size></box></geometry>
          <material><ambient>0.1 0.75 0.2 1</ambient><diffuse>0.15 0.85 0.25 1</diffuse></material>
