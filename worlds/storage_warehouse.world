<?xml version="1.0" ?>
<sdf version="1.6">
  <!-- Large warehouse + colored pick boxes + corner drop pads. -->
  <world name="storage_warehouse">

    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Publishes /gazebo/model_states so detectors use real world poses (not odom drift) -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>20</update_rate>
    </plugin>

    <!-- Outer walls: 32 x 22 m -->
    <model name="wall_n">
      <static>true</static>
      <pose>0 11 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>32.4 0.25 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>32.4 0.25 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_s">
      <static>true</static>
      <pose>0 -11 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>32.4 0.25 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>32.4 0.25 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_e">
      <static>true</static>
      <pose>16 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.25 22 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.25 22 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_w">
      <static>true</static>
      <pose>-16 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.25 22 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.25 22 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rack islands -->
    <model name="rack_1">
      <static>true</static>
      <pose>-6 -3.5 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.8 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6 0.8 2</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rack_2">
      <static>true</static>
      <pose>6 -3.5 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.8 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6 0.8 2</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rack_3">
      <static>true</static>
      <pose>-6 3.5 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.8 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6 0.8 2</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rack_4">
      <static>true</static>
      <pose>6 3.5 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.8 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6 0.8 2</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Bigger colored boxes (~0.55 m). Clear of spawn (origin). -->
    <model name="box_orange_1">
      <pose>-3 4.5 0.28 0 0 0.2</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.55 0.55 0.55</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.55 0.55 0.55</size></box></geometry>
          <material><ambient>0.95 0.45 0.05 1</ambient><diffuse>1.0 0.5 0.05 1</diffuse></material>
        </visual>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
    </model>
    <model name="box_orange_2">
      <pose>10 2 0.28 0 0 -0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.55 0.55 0.55</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.55 0.55 0.55</size></box></geometry>
          <material><ambient>0.95 0.45 0.05 1</ambient><diffuse>1.0 0.5 0.05 1</diffuse></material>
        </visual>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
    </model>

    <model name="box_blue_1">
      <pose>3 -7 0.28 0 0 0.1</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.55 0.55 0.55</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.55 0.55 0.55</size></box></geometry>
          <material><ambient>0.05 0.35 0.95 1</ambient><diffuse>0.1 0.4 1.0 1</diffuse></material>
        </visual>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
    </model>
    <model name="box_blue_2">
      <pose>-10 -2 0.28 0 0 0.4</pose>
      <link name="link">
