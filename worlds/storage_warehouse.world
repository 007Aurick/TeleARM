<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="storage_warehouse">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Outer walls: 32 x 22 m -->
    <model name="wall_n">
      <static>true</static>
      <pose>0 11 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>32.4 0.25 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>32.4 0.25 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_s">
      <static>true</static>
      <pose>0 -11 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>32.4 0.25 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>32.4 0.25 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_e">
      <static>true</static>
      <pose>16 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.25 22 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.25 22 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_w">
      <static>true</static>
      <pose>-16 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.25 22 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.25 22 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rack islands: ~6-7m clear on every side (wall, neighbor rack, and center cross-aisle), no dead-end corners -->
    <model name="rack_1">
      <static>true</static>
      <pose>-6 -3.5 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.8 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6 0.8 2</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rack_2">
      <static>true</static>
      <pose>6 -3.5 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.8 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6 0.8 2</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rack_3">
      <static>true</static>
      <pose>-6 3.5 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.8 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6 0.8 2</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rack_4">
      <static>true</static>
      <pose>6 3.5 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.8 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6 0.8 2</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    
  
  </world>
</sdf>
