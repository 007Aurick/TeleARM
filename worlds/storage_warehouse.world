<?xml version="1.0" ?>
<sdf version="1.6">
  <!-- Large warehouse + colored pick boxes + corner drop pads. -->
  <world name="storage_warehouse">

    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>1.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Publishes /gazebo/model_states so detectors use real world poses (not odom drift) -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>20</update_rate>
    </plugin>

    <!-- Outer walls: 50 x 36 m — room for a ~3 m forklift to turn -->
    <model name="wall_n">
      <static>true</static>
      <pose>0 18 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>50.4 0.25 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>50.4 0.25 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_s">
      <static>true</static>
      <pose>0 -18 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>50.4 0.25 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>50.4 0.25 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_e">
      <static>true</static>
      <pose>25 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.25 36 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.25 36 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_w">
      <static>true</static>
      <pose>-25 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.25 36 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.25 36 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Shorter racks, wide aisles (~10 m clear) so the car can turn -->
    <model name="rack_1">
      <static>true</static>
      <pose>-14 -9 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5 0.7 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5 0.7 2</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rack_2">
      <static>true</static>
      <pose>14 -9 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5 0.7 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5 0.7 2</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rack_3">
      <static>true</static>
      <pose>-14 9 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5 0.7 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5 0.7 2</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rack_4">
      <static>true</static>
      <pose>14 9 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5 0.7 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5 0.7 2</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Colored boxes (~0.90 m). Clear of spawn (origin). -->
    <model name="box_orange_1">
      <pose>-6 6 0.45 0 0 0.2</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.90 0.90 0.90</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
            </friction>
            <contact>
              <ode><kp>5000</kp><kd>20</kd><max_vel>0.1</max_vel></ode>
            </contact>
          </surface>
        </collision>
        <!-- Full color face + black EDGE frame only -->
        <visual name="v"><geometry><box><size>0.90 0.90 0.90</size></box></geometry>
          <material><ambient>0.95 0.45 0.05 1</ambient><diffuse>1.0 0.5 0.05 1</diffuse></material>
        </visual>
        <visual name="edge_1"><pose>0 -0.46 -0.46 0 0 0</pose><geometry><box><size>0.9 0.05 0.05</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
        <visual name="edge_2"><pose>0 -0.46 0.46 0 0 0</pose><geometry><box><size>0.9 0.05 0.05</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
