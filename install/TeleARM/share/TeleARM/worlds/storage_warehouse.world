<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="storage_warehouse">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Outer walls: 20 x 16 m -->
    <model name="wall_n">
      <static>true</static>
      <pose>0 8 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20.4 0.25 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.4 0.25 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_s">
      <static>true</static>
      <pose>0 -8 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20.4 0.25 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.4 0.25 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_e">
      <static>true</static>
      <pose>10 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.25 16 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.25 16 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_w">
      <static>true</static>
      <pose>-10 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.25 16 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.25 16 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rack rows (leave center clear for spawn) -->
    <model name="rack_1">
      <static>true</static>
      <pose>-5 -4.5 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.8 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6 0.8 2</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rack_2">
      <static>true</static>
      <pose>5 -4.5 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.8 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6 0.8 2</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rack_3">
      <static>true</static>
      <pose>-5 4.5 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.8 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6 0.8 2</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rack_4">
      <static>true</static>
      <pose>5 4.5 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.8 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6 0.8 2</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A couple crates in the aisle -->
    <model name="crate_a">
      <static>true</static>
      <pose>2.5 0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.6 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.6 0.7</size></box></geometry>
          <material><ambient>0.7 0.45 0.2 1</ambient><diffuse>0.7 0.45 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="crate_b">
      <static>true</static>
      <pose>-3 0 0.3 0 0 0.2</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.7 0.7 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.7 0.7 0.6</size></box></geometry>
          <material><ambient>0.7 0.45 0.2 1</ambient><diffuse>0.7 0.45 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
